+static int smart_kthread_create(struct smart_policy *sg_policy)
+{
+	struct task_struct *thread;
+	struct sched_attr attr = {
+		.size		= sizeof(struct sched_attr),
+		.sched_policy	= SCHED_DEADLINE,
+		.sched_flags	= SCHED_FLAG_SUGOV,
+		.sched_nice	= 0,
+		.sched_priority	= 0,
+		/*
+		 * Fake (unused) bandwidth; workaround to "fix"
+		 * priority inheritance.
+		 */
+		.sched_runtime	=  1000000,
+		.sched_deadline = 10000000,
+		.sched_period	= 10000000,
+	};
+	struct cpufreq_policy *policy = sg_policy->policy;
+	int ret;
+
+	/* kthread only required for slow path */
+	if (policy->fast_switch_enabled)
+		return 0;
+
+	kthread_init_work(&sg_policy->work, smart_work);
+	kthread_init_worker(&sg_policy->worker);
+	thread = kthread_create(kthread_worker_fn, &sg_policy->worker,
+				"smartutil:%d",
+				cpumask_first(policy->related_cpus));
+	if (IS_ERR(thread)) {
+		pr_err("failed to create smartutil thread: %ld\n", PTR_ERR(thread));
+		return PTR_ERR(thread);
+	}
+
+	ret = sched_setattr_nocheck(thread, &attr);
+	if (ret) {
+		kthread_stop(thread);
+		pr_warn("%s: failed to set SCHED_DEADLINE\n", __func__);
+		return ret;
+	}
+
+	sg_policy->thread = thread;
+	kthread_bind_mask(thread, policy->related_cpus);
+	init_irq_work(&sg_policy->irq_work, smart_irq_work);
+	mutex_init(&sg_policy->work_lock);
+	wake_up_process(thread);
+	return 0;
+}
+
+static void smart_kthread_stop(struct smart_policy *sg_policy)
+{
+	/* kthread only required for slow path */
+	if (sg_policy->policy->fast_switch_enabled)
+		return;
+
+	kthread_flush_worker(&sg_policy->worker);
+	kthread_stop(sg_policy->thread);
+	mutex_destroy(&sg_policy->work_lock);
+}
+
+static struct smart_tunables *smart_tunables_alloc(struct smart_policy *sg_policy)
+{
+	struct smart_tunables *tunables;
+
+	tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
+	if (tunables) {
+		gov_attr_set_init(&tunables->attr_set, &sg_policy->tunables_hook);
+		if (!have_governor_per_policy())
+			global_tunables = tunables;
+	}
+	return tunables;
+}
+
+static void smart_clear_global_tunables(void)
+{
+	if (!have_governor_per_policy())
+		global_tunables = NULL;
+}
+
+static int smart_init(struct cpufreq_policy *policy)
+{
+	struct smart_policy *sg_policy;
+	struct smart_tunables *tunables;
+	int ret = 0;
+
+	/* State should be equivalent to EXIT */
+	if (policy->governor_data)
+		return -EBUSY;
+
+	cpufreq_enable_fast_switch(policy);
+
+	sg_policy = smart_policy_alloc(policy);
+	if (!sg_policy) {
+		ret = -ENOMEM;
+		goto disable_fast_switch;
+	}
+
+	ret = smart_kthread_create(sg_policy);
+	if (ret)
+		goto free_sg_policy;
+
+	mutex_lock(&global_tunables_lock);
+
+	if (global_tunables) {
+		if (WARN_ON(have_governor_per_policy())) {
+			ret = -EINVAL;
+			goto stop_kthread;
+		}
+		policy->governor_data = sg_policy;
+		sg_policy->tunables = global_tunables;
+		gov_attr_set_get(&global_tunables->attr_set, &sg_policy->tunables_hook);
+		goto out;
+	}
+
+	tunables = smart_tunables_alloc(sg_policy);
+	if (!tunables) {
+		ret = -ENOMEM;
+		goto stop_kthread;
+	}
+
+	tunables->rate_limit_us = cpufreq_policy_transition_delay_us(policy);
+	tunables->smart_enabled = true;
+	tunables->idle_util_thresh = 25;
+	tunables->idle_freq_cap_pct = 40;
+	tunables->heavy_util_thresh = 70;
+	tunables->heavy_freq_cap_pct = 95;
+	tunables->heavy_sustain_cap_pct = 80;
+	tunables->sustain_after_us = 3000000;
+	tunables->heavy_nr_running = 2;
+	tunables->ramp_up_step_pct = 10;
+	tunables->ramp_down_step_pct = 15;
+	tunables->mode_hysteresis = 10;
+
+	policy->governor_data = sg_policy;
+	sg_policy->tunables = tunables;
+
+	ret = kobject_init_and_add(&tunables->attr_set.kobj, &smart_tunables_ktype,
+				   get_governor_parent_kobj(policy), "%s",
+				   smartutil_gov.name);
+	if (ret)
+		goto fail;
+
+out:
+	mutex_unlock(&global_tunables_lock);
+	return 0;
+
+fail:
+	kobject_put(&tunables->attr_set.kobj);
+	policy->governor_data = NULL;
+	smart_clear_global_tunables();
+
+stop_kthread:
+	smart_kthread_stop(sg_policy);
+	mutex_unlock(&global_tunables_lock);
+
+free_sg_policy:
+	smart_policy_free(sg_policy);
+
+disable_fast_switch:
+	cpufreq_disable_fast_switch(policy);
+
+	pr_err("initialization failed (error %d)\n", ret);
+	return ret;
+}
+
+static void smart_exit(struct cpufreq_policy *policy)
+{
+	struct smart_policy *sg_policy = policy->governor_data;
+	struct smart_tunables *tunables = sg_policy->tunables;
+	unsigned int count;
+
+	mutex_lock(&global_tunables_lock);
+
+	count = gov_attr_set_put(&tunables->attr_set, &sg_policy->tunables_hook);
+	policy->governor_data = NULL;
+
+	if (!count)
+		smart_clear_global_tunables();
+
+	mutex_unlock(&global_tunables_lock);
+
+	smart_kthread_stop(sg_policy);
+	smart_policy_free(sg_policy);
+	cpufreq_disable_fast_switch(policy);
+}
+
+static int smart_start(struct cpufreq_policy *policy)
+{
+	struct smart_policy *sg_policy = policy->governor_data;
+	void (*uu)(struct update_util_data *data, u64 time, unsigned int flags);
+	unsigned int cpu;
+
+	sg_policy->freq_update_delay_ns	= sg_policy->tunables->rate_limit_us * NSEC_PER_USEC;
+	sg_policy->last_freq_update_time	= 0;
+	sg_policy->next_freq		= 0;
+	sg_policy->work_in_progress	= false;
+	sg_policy->limits_changed	= false;
+	sg_policy->cached_raw_freq	= 0;
+	sg_policy->mode			= SMART_MODE_NORMAL;
+	sg_policy->heavy_since		= 0;
+	sg_policy->need_freq_update = cpufreq_driver_test_flags(CPUFREQ_NEED_UPDATE_LIMITS);
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct smart_cpu *sg_cpu = &per_cpu(smart_cpu, cpu);
+
+		memset(sg_cpu, 0, sizeof(*sg_cpu));
+		sg_cpu->cpu		= cpu;
+		sg_cpu->sg_policy	= sg_policy;
+	}
+
+	if (policy_is_shared(policy))
+		uu = smart_update_shared;
+	else if (policy->fast_switch_enabled && cpufreq_driver_has_adjust_perf())
+		uu = smart_update_single_perf;
+	else
+		uu = smart_update_single_freq;
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct smart_cpu *sg_cpu = &per_cpu(smart_cpu, cpu);
+
+		cpufreq_add_update_util_hook(cpu, &sg_cpu->update_util, uu);
+	}
+
+	return 0;
+}
+
+static void smart_stop(struct cpufreq_policy *policy)
+{
+	struct smart_policy *sg_policy = policy->governor_data;
+	unsigned int cpu;
+
+	for_each_cpu(cpu, policy->cpus)
+		cpufreq_remove_update_util_hook(cpu);
+
+	synchronize_rcu();
+
+	if (!policy->fast_switch_enabled) {
+		irq_work_sync(&sg_policy->irq_work);
+		kthread_cancel_work_sync(&sg_policy->work);
+	}
+}
+
+static void smart_limits(struct cpufreq_policy *policy)
+{
+	struct smart_policy *sg_policy = policy->governor_data;
+
+	if (!policy->fast_switch_enabled) {
+		mutex_lock(&sg_policy->work_lock);
+		cpufreq_policy_apply_limits(policy);
+		mutex_unlock(&sg_policy->work_lock);
+	}
+
+	sg_policy->limits_changed = true;
+}
+
+cpufreq_governor_init(smartutil_gov);
