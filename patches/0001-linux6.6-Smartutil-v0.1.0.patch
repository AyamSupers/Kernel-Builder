From f7494fd7fcb15a20e71abe6d017306c4869ce4cc Mon Sep 17 00:00:00 2001
From: artecxyz <artecxyz404@gmail.com>
Date: Thu, 22 Oct 2026 14:24:49 +0700
Subject: [PATCH] Smartutil CPUFreq Governor v0.1.0

---
 drivers/cpufreq/Kconfig          |   32 +
 kernel/sched/build_utility.c     |    4 +
 kernel/sched/cpufreq_smartutil.c | 1082 ++++++++++++++++++++++++++++++
 3 files changed, 1118 insertions(+)
 create mode 100644 kernel/sched/cpufreq_smartutil.c

diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
index a1b82168a942..a656caf67d43 100644
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -112,6 +112,17 @@ config CPU_FREQ_DEFAULT_GOV_SCHEDUTIL
 	  have a look at the help section of that governor. The fallback
 	  governor will be 'performance'.
 
+config CPU_FREQ_DEFAULT_GOV_SMARTUTIL
+	bool "smartutil"
+	depends on SMP
+	select CPU_FREQ_GOV_SMARTUTIL
+	select CPU_FREQ_GOV_PERFORMANCE
+	help
+	  Use the 'smartutil' CPUFreq governor by default. This governor is a
+	  standalone variant of 'schedutil' with its own tunables. If unsure,
+	  have a look at the help section of that governor. The fallback
+	  governor will be 'performance'.
+
 endchoice
 
 config CPU_FREQ_GOV_PERFORMANCE
@@ -210,6 +221,27 @@ config CPU_FREQ_GOV_SCHEDUTIL
 
 	  If in doubt, say N.
 
+config CPU_FREQ_GOV_SMARTUTIL
+	bool "'smartutil' cpufreq policy governor"
+	depends on CPU_FREQ && SMP
+	select CPU_FREQ_GOV_ATTR_SET
+	select IRQ_WORK
+	help
+	  This governor makes decisions based on the utilization data provided
+	  by the scheduler.  It sets the CPU frequency to be proportional to
+	  the utilization/capacity ratio coming from the scheduler.  If the
+	  utilization is frequency-invariant, the new frequency is also
+	  proportional to the maximum available frequency.  If that is not the
+	  case, it is proportional to the current frequency of the CPU.  The
+	  frequency tipping point is at utilization/capacity equal to 80% in
+	  both cases.
+
+	  This is a standalone variant of 'schedutil' that registers under its
+	  own name and owns its own tunables, so both governors can be built in
+	  at the same time and selected independently at runtime.
+
+	  If in doubt, say N.
+
 comment "CPU frequency scaling drivers"
 
 config CPUFREQ_DT
diff --git a/kernel/sched/build_utility.c b/kernel/sched/build_utility.c
index d6679d7352eb..7633dda77b20 100644
--- a/kernel/sched/build_utility.c
+++ b/kernel/sched/build_utility.c
@@ -73,6 +73,10 @@
 # include "cpufreq_schedutil.c"
 #endif
 
+#ifdef CONFIG_CPU_FREQ_GOV_SMARTUTIL
+# include "cpufreq_smartutil.c"
+#endif
+
 #ifdef CONFIG_SCHED_DEBUG
 # include "debug.c"
 #endif
diff --git a/kernel/sched/cpufreq_smartutil.c b/kernel/sched/cpufreq_smartutil.c
new file mode 100644
index 000000000000..a29c4d99e401
--- /dev/null
+++ b/kernel/sched/cpufreq_smartutil.c
@@ -0,0 +1,1082 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Smartutil CPUFreq governor (based on schedutil)
+ *
+ * This is a standalone governor derived from 'schedutil'. It keeps the exact
+ * same framework as schedutil, but registers under its own name and owns its
+ * own set of tunables, so it can be tuned (or replaced) independently without
+ * affecting the stock 'schedutil' governor.
+ *
+ * Copyright (C) 2026 Artecxyz
+ * Copyright (C) 2016, Intel Corporation
+ * Author: Rafael J. Wysocki <rafael.j.wysocki@intel.com>
+ */
+
+#include <trace/hooks/sched.h>
+
+#define CPUFREQ_SMARTUTIL_PROGNAME "Smartutil CPUFreq Governor"
+#define CPUFREQ_SMARTUTIL_AUTHOR   "Artecxyz"
+
+#define SMUT_IOWAIT_BOOST_MIN	(SCHED_CAPACITY_SCALE / 8)
+
+struct smut_tunables {
+	struct gov_attr_set	attr_set;
+
+	/*
+	 * Rate limits, in microseconds. Unlike schedutil, smartutil keeps
+	 * separate limits for the two directions, so an idle CPU can fall
+	 * back to policy->min quickly without also letting the frequency
+	 * ramp up just as eagerly.
+	 */
+	unsigned int		up_rate_limit_us;
+	unsigned int		down_rate_limit_us;
+
+	/*
+	 * Load tiers, in percent of CPU capacity. util/max below
+	 * target_load1 is "light", between the two is "medium", above
+	 * target_load2 is "heavy".
+	 */
+	unsigned int		target_load1;
+	unsigned int		target_load2;
+
+	/*
+	 * Headroom / trim, in percent, applied on top of the strictly
+	 * proportional base mapping. Light load gets a little headroom so
+	 * the governor stays reactive; heavy load is trimmed so a game is
+	 * answered without parking the CPU at max.
+	 */
+	unsigned int		boost_light_pct;
+	unsigned int		cut_heavy_pct;
+
+	/*
+	 * Per-tier frequency ceiling, in percent of policy->cpuinfo.max_freq.
+	 * 100 disables the cap for that tier. Lowering cap_heavy_pct on the
+	 * prime policy is the strongest single heat-control knob.
+	 */
+	unsigned int		cap_light_pct;
+	unsigned int		cap_mid_pct;
+	unsigned int		cap_heavy_pct;
+};
+
+struct smut_policy {
+	struct cpufreq_policy	*policy;
+
+	struct smut_tunables	*tunables;
+	struct list_head	tunables_hook;
+
+	raw_spinlock_t		update_lock;
+	u64			last_freq_update_time;
+	s64			min_rate_limit_ns;
+	s64			up_rate_delay_ns;
+	s64			down_rate_delay_ns;
+	unsigned int		next_freq;
+	unsigned int		cached_raw_freq;
+
+	/* The next fields are only needed if fast switch cannot be used: */
+	struct			irq_work irq_work;
+	struct			kthread_work work;
+	struct			mutex work_lock;
+	struct			kthread_worker worker;
+	struct task_struct	*thread;
+	bool			work_in_progress;
+
+	bool			limits_changed;
+	bool			need_freq_update;
+};
+
+struct smut_cpu {
+	struct update_util_data	update_util;
+	struct smut_policy	*sg_policy;
+	unsigned int		cpu;
+
+	bool			iowait_boost_pending;
+	unsigned int		iowait_boost;
+	u64			last_update;
+
+	unsigned long		util;
+	unsigned long		bw_dl;
+};
+
+static DEFINE_PER_CPU(struct smut_cpu, smut_cpu);
+
+/*
+ * Protects min_rate_limit_ns across all policies sharing one tunables set,
+ * since two rate limits can be written concurrently.
+ */
+static DEFINE_MUTEX(smut_min_rate_lock);
+
+/************************ Governor internals ***********************/
+
+static void smut_update_min_rate_limit_ns(struct smut_policy *sg_policy)
+{
+	mutex_lock(&smut_min_rate_lock);
+	sg_policy->min_rate_limit_ns =
+		min(sg_policy->up_rate_delay_ns, sg_policy->down_rate_delay_ns);
+	mutex_unlock(&smut_min_rate_lock);
+}
+
+static bool smut_up_down_rate_limit(struct smut_policy *sg_policy, u64 time,
+				    unsigned int next_freq)
+{
+	s64 delta_ns = time - sg_policy->last_freq_update_time;
+
+	/*
+	 * If the frequency is being raised, the up rate limit applies; if it
+	 * is being lowered, the down rate limit does. A transition is only
+	 * throttled by the limit of the direction it is actually moving in,
+	 * so the two knobs can never block each other.
+	 */
+	if (next_freq > sg_policy->next_freq &&
+	    delta_ns < sg_policy->up_rate_delay_ns)
+		return true;
+
+	if (next_freq < sg_policy->next_freq &&
+	    delta_ns < sg_policy->down_rate_delay_ns)
+		return true;
+
+	return false;
+}
+
+static bool smut_should_update_freq(struct smut_policy *sg_policy, u64 time)
+{
+	/*
+	 * Since cpufreq_update_util() is called with rq->lock held for
+	 * the @target_cpu, our per-CPU data is fully serialized.
+	 *
+	 * However, drivers cannot in general deal with cross-CPU
+	 * requests, so while smut_next_freq() will work, our
+	 * smut_update_commit() call may not for the fast switching platforms.
+	 *
+	 * Hence stop here for remote requests if they aren't supported
+	 * by the hardware, as calculating the frequency is pointless if
+	 * we cannot in fact act on it.
+	 *
+	 * This is needed on the slow switching platforms too to prevent CPUs
+	 * going offline from leaving stale IRQ work items behind.
+	 */
+	if (!cpufreq_this_cpu_can_update(sg_policy->policy))
+		return false;
+
+	if (unlikely(sg_policy->limits_changed)) {
+		sg_policy->limits_changed = false;
+		sg_policy->need_freq_update = true;
+		return true;
+	}
+
+	/*
+	 * Nothing to gain from recalculating next freq again before
+	 * min_rate_limit_ns has elapsed. The direction-specific limits are
+	 * applied later, once the direction is known.
+	 */
+	return time - sg_policy->last_freq_update_time >=
+		sg_policy->min_rate_limit_ns;
+}
+
+static bool smut_update_next_freq(struct smut_policy *sg_policy, u64 time,
+				   unsigned int next_freq)
+{
+	if (sg_policy->need_freq_update) {
+		sg_policy->need_freq_update = false;
+		/*
+		 * The policy limits have changed, but if the return value of
+		 * cpufreq_driver_resolve_freq() after applying the new limits
+		 * is still equal to the previously selected frequency, the
+		 * driver callback need not be invoked unless the driver
+		 * specifically wants that to happen on every update of the
+		 * policy limits.
+		 */
+		if (sg_policy->next_freq == next_freq &&
+		    !cpufreq_driver_test_flags(CPUFREQ_NEED_UPDATE_LIMITS))
+			return false;
+	} else if (sg_policy->next_freq == next_freq) {
+		return false;
+	}
+
+	/*
+	 * Now that the direction of the transition is known, apply the rate
+	 * limit for that direction only.
+	 */
+	if (smut_up_down_rate_limit(sg_policy, time, next_freq))
+		return false;
+
+	sg_policy->next_freq = next_freq;
+	sg_policy->last_freq_update_time = time;
+
+	return true;
+}
+
+static void smut_deferred_update(struct smut_policy *sg_policy)
+{
+	if (!sg_policy->work_in_progress) {
+		sg_policy->work_in_progress = true;
+		irq_work_queue(&sg_policy->irq_work);
+	}
+}
+
+/**
+ * smut_capacity_ref_freq - get the reference frequency that has been used to
+ * correlate frequency and compute capacity for a given cpufreq policy. We use
+ * the CPU managing it for the arch_scale_freq_ref() call in the function.
+ * @policy: the cpufreq policy of the CPU in question.
+ *
+ * Return: the reference CPU frequency to compute a capacity.
+ */
+static __always_inline
+unsigned long smut_capacity_ref_freq(struct cpufreq_policy *policy)
+{
+	unsigned int freq = arch_scale_freq_ref(policy->cpu);
+
+	if (freq)
+		return freq;
+
+	if (arch_scale_freq_invariant())
+		return policy->cpuinfo.max_freq;
+
+	/*
+	 * Apply a 25% margin so that we select a higher frequency than
+	 * the current one before the CPU is fully busy:
+	 */
+	return policy->cur + (policy->cur >> 2);
+}
+
+/**
+ * smut_next_freq - Compute a new frequency for a given cpufreq policy.
+ * @sg_policy: smartutil policy object to compute the new frequency for.
+ * @util: Current CPU utilization.
+ * @max: CPU capacity.
+ *
+ * The base mapping is strictly proportional to the utilization, with no
+ * fixed headroom, so a lightly loaded or idle CPU is driven towards
+ * policy->min instead of hovering in the middle of the OPP table:
+ *
+ *	base = ref_freq * util / max
+ *
+ * On top of that, three load tiers decide how much headroom or trim to
+ * apply and whether a frequency ceiling is in force:
+ *
+ *	light  (load <  target_load1): base + boost_light_pct
+ *	medium (target_load1..target_load2): base as-is
+ *	heavy  (load >= target_load2): base - cut_heavy_pct
+ *
+ * Each tier also has a cap expressed as a percentage of
+ * policy->cpuinfo.max_freq, which bounds the result no matter how high the
+ * utilization goes. That cap is the main heat control: a game is answered
+ * with the frequency it actually needs rather than the maximum.
+ *
+ * The lowest driver-supported frequency which is equal or greater than the
+ * raw next_freq (as calculated above) is returned, subject to policy min/max
+ * and cpufreq driver limitations.
+ */
+static unsigned int smut_next_freq(struct smut_policy *sg_policy,
+				   unsigned long util, unsigned long max)
+{
+	struct cpufreq_policy *policy = sg_policy->policy;
+	struct smut_tunables *tunables = sg_policy->tunables;
+	unsigned int freq, cap_pct, max_freq;
+	unsigned long next_freq = 0;
+	unsigned long load = 100 * util / max;
+
+	freq = smut_capacity_ref_freq(policy);
+	max_freq = policy->cpuinfo.max_freq;
+
+	trace_android_vh_map_util_freq(util, freq, max, &next_freq, policy,
+				       &sg_policy->need_freq_update);
+	if (next_freq) {
+		freq = next_freq;
+	} else {
+		freq = map_util_freq(util, freq, max);
+
+		if (load < tunables->target_load1) {
+			/*
+			 * Light load. A little headroom keeps the governor
+			 * reactive (app launch, scrolling) without parking
+			 * the CPU high.
+			 */
+			freq += freq * tunables->boost_light_pct / 100;
+			cap_pct = tunables->cap_light_pct;
+		} else if (load < tunables->target_load2) {
+			/* Medium load: the load alone decides. */
+			cap_pct = tunables->cap_mid_pct;
+		} else {
+			/*
+			 * Heavy load. Trim the target so the CPU answers the
+			 * load without being pinned at max; the last few
+			 * percent of frequency are the most expensive in
+			 * power and heat.
+			 */
+			freq -= freq * tunables->cut_heavy_pct / 100;
+			cap_pct = tunables->cap_heavy_pct;
+		}
+
+		if (cap_pct < 100)
+			freq = min_t(unsigned int, freq, max_freq * cap_pct / 100);
+	}
+
+	if (freq == sg_policy->cached_raw_freq && !sg_policy->need_freq_update)
+		return sg_policy->next_freq;
+
+	sg_policy->cached_raw_freq = freq;
+	return cpufreq_driver_resolve_freq(policy, freq);
+}
+
+/*
+ * NOTE: this is the one part of the governor that is tied to the host
+ * kernel's scheduler-util API. Upstream 6.6 exposes
+ * effective_cpu_util(cpu, util, FREQUENCY_UTIL, NULL); this tree instead
+ * exposes effective_cpu_util(cpu, util, &min, &max). The two are
+ * equivalent in effect, only the plumbing differs.
+ */
+static void smut_get_util(struct smut_cpu *sg_cpu)
+{
+	unsigned long min, max, util = cpu_util_cfs_boost(sg_cpu->cpu);
+
+	sg_cpu->bw_dl = cpu_bw_dl(cpu_rq(sg_cpu->cpu));
+	util = effective_cpu_util(sg_cpu->cpu, util, &min, &max);
+
+	/*
+	 * Deliberately no map_util_perf() headroom here. schedutil bakes a
+	 * fixed 25% headroom into the utilization, which pins the frequency
+	 * high across the whole light-load range. smartutil applies its own
+	 * load-dependent headroom in smut_next_freq(), so the tipping point is
+	 * fully owned by the tunables instead.
+	 */
+	if (util < max)
+		max = util;
+
+	/*
+	 * Ensure at least minimum performance while providing more compute
+	 * capacity when possible.
+	 */
+	sg_cpu->util = max(min, max);
+}
+
+/**
+ * smut_iowait_reset() - Reset the IO boost status of a CPU.
+ * @sg_cpu: the smartutil data for the CPU to boost
+ * @time: the update time from the caller
+ * @set_iowait_boost: true if an IO boost has been requested
+ *
+ * The IO wait boost of a task is disabled after a tick since the last update
+ * of a CPU. If a new IO wait boost is requested after more then a tick, then
+ * we enable the boost starting from SMUT_IOWAIT_BOOST_MIN, which improves energy
+ * efficiency by ignoring sporadic wakeups from IO.
+ */
+static bool smut_iowait_reset(struct smut_cpu *sg_cpu, u64 time,
+			       bool set_iowait_boost)
+{
+	s64 delta_ns = time - sg_cpu->last_update;
+
+	/* Reset boost only if a tick has elapsed since last request */
+	if (delta_ns <= TICK_NSEC)
+		return false;
+
+	sg_cpu->iowait_boost = set_iowait_boost ? SMUT_IOWAIT_BOOST_MIN : 0;
+	sg_cpu->iowait_boost_pending = set_iowait_boost;
+
+	return true;
+}
+
+/**
+ * smut_iowait_boost() - Updates the IO boost status of a CPU.
+ * @sg_cpu: the smartutil data for the CPU to boost
+ * @time: the update time from the caller
+ * @flags: SCHED_CPUFREQ_IOWAIT if the task is waking up after an IO wait
+ *
+ * Each time a task wakes up after an IO operation, the CPU utilization can be
+ * boosted to a certain utilization which doubles at each "frequent and
+ * successive" wakeup from IO, ranging from SMUT_IOWAIT_BOOST_MIN to the utilization
+ * of the maximum OPP.
+ *
+ * To keep doubling, an IO boost has to be requested at least once per tick,
+ * otherwise we restart from the utilization of the minimum OPP.
+ */
+static void smut_iowait_boost(struct smut_cpu *sg_cpu, u64 time,
+			       unsigned int flags)
+{
+	bool set_iowait_boost = flags & SCHED_CPUFREQ_IOWAIT;
+
+	/* Reset boost if the CPU appears to have been idle enough */
+	if (sg_cpu->iowait_boost &&
+	    smut_iowait_reset(sg_cpu, time, set_iowait_boost))
+		return;
+
+	/* Boost only tasks waking up after IO */
+	if (!set_iowait_boost)
+		return;
+
+	/* Ensure boost doubles only one time at each request */
+	if (sg_cpu->iowait_boost_pending)
+		return;
+	sg_cpu->iowait_boost_pending = true;
+
+	/* Double the boost at each request */
+	if (sg_cpu->iowait_boost) {
+		sg_cpu->iowait_boost =
+			min_t(unsigned int, sg_cpu->iowait_boost << 1, SCHED_CAPACITY_SCALE);
+		return;
+	}
+
+	/* First wakeup after IO: start with minimum boost */
+	sg_cpu->iowait_boost = SMUT_IOWAIT_BOOST_MIN;
+}
+
+/**
+ * smut_iowait_apply() - Apply the IO boost to a CPU.
+ * @sg_cpu: the smartutil data for the cpu to boost
+ * @time: the update time from the caller
+ * @max_cap: the max CPU capacity
+ *
+ * A CPU running a task which woken up after an IO operation can have its
+ * utilization boosted to speed up the completion of those IO operations.
+ * The IO boost value is increased each time a task wakes up from IO, in
+ * smut_iowait_apply(), and it's instead decreased by this function,
+ * each time an increase has not been requested (!iowait_boost_pending).
+ *
+ * A CPU which also appears to have been idle for at least one tick has also
+ * its IO boost utilization reset.
+ *
+ * This mechanism is designed to boost high frequently IO waiting tasks, while
+ * being more conservative on tasks which does sporadic IO operations.
+ */
+static void smut_iowait_apply(struct smut_cpu *sg_cpu, u64 time,
+			       unsigned long max_cap)
+{
+	unsigned long boost;
+
+	/* No boost currently required */
+	if (!sg_cpu->iowait_boost)
+		return;
+
+	/* Reset boost if the CPU appears to have been idle enough */
+	if (smut_iowait_reset(sg_cpu, time, false))
+		return;
+
+	if (!sg_cpu->iowait_boost_pending) {
+		/*
+		 * No boost pending; reduce the boost value.
+		 */
+		sg_cpu->iowait_boost >>= 1;
+		if (sg_cpu->iowait_boost < SMUT_IOWAIT_BOOST_MIN) {
+			sg_cpu->iowait_boost = 0;
+			return;
+		}
+	}
+
+	sg_cpu->iowait_boost_pending = false;
+
+	/*
+	 * sg_cpu->util is already in capacity scale; convert iowait_boost
+	 * into the same scale so we can compare.
+	 */
+	boost = (sg_cpu->iowait_boost * max_cap) >> SCHED_CAPACITY_SHIFT;
+	if (sg_cpu->util < boost)
+		sg_cpu->util = boost;
+}
+
+/*
+ * Make smut_should_update_freq() ignore the rate limit when DL
+ * has increased the utilization.
+ */
+static inline void smut_ignore_dl_rate_limit(struct smut_cpu *sg_cpu)
+{
+	if (cpu_bw_dl(cpu_rq(sg_cpu->cpu)) > sg_cpu->bw_dl)
+		sg_cpu->sg_policy->limits_changed = true;
+}
+
+static inline bool smut_update_single_common(struct smut_cpu *sg_cpu,
+					      u64 time, unsigned long max_cap,
+					      unsigned int flags)
+{
+	smut_iowait_boost(sg_cpu, time, flags);
+	sg_cpu->last_update = time;
+
+	smut_ignore_dl_rate_limit(sg_cpu);
+
+	if (!smut_should_update_freq(sg_cpu->sg_policy, time))
+		return false;
+
+	smut_get_util(sg_cpu);
+	smut_iowait_apply(sg_cpu, time, max_cap);
+
+	return true;
+}
+
+static void smut_update_single_freq(struct update_util_data *hook, u64 time,
+				     unsigned int flags)
+{
+	struct smut_cpu *sg_cpu = container_of(hook, struct smut_cpu, update_util);
+	struct smut_policy *sg_policy = sg_cpu->sg_policy;
+	unsigned long max_cap;
+	unsigned int next_f;
+
+	max_cap = arch_scale_cpu_capacity(sg_cpu->cpu);
+
+	if (!smut_update_single_common(sg_cpu, time, max_cap, flags))
+		return;
+
+	next_f = smut_next_freq(sg_policy, sg_cpu->util, max_cap);
+
+	if (!smut_update_next_freq(sg_policy, time, next_f))
+		return;
+
+	/*
+	 * This code runs under rq->lock for the target CPU, so it won't run
+	 * concurrently on two different CPUs for the same target and it is not
+	 * necessary to acquire the lock in the fast switch case.
+	 */
+	if (sg_policy->policy->fast_switch_enabled) {
+		cpufreq_driver_fast_switch(sg_policy->policy, next_f);
+	} else {
+		raw_spin_lock(&sg_policy->update_lock);
+		smut_deferred_update(sg_policy);
+		raw_spin_unlock(&sg_policy->update_lock);
+	}
+}
+
+static void smut_update_single_perf(struct update_util_data *hook, u64 time,
+				     unsigned int flags)
+{
+	struct smut_cpu *sg_cpu = container_of(hook, struct smut_cpu, update_util);
+	unsigned long max_cap;
+
+	/*
+	 * Fall back to the "frequency" path if frequency invariance is not
+	 * supported, because the direct mapping between the utilization and
+	 * the performance levels depends on the frequency invariance.
+	 */
+	if (!arch_scale_freq_invariant()) {
+		smut_update_single_freq(hook, time, flags);
+		return;
+	}
+
+	max_cap = arch_scale_cpu_capacity(sg_cpu->cpu);
+
+	if (!smut_update_single_common(sg_cpu, time, max_cap, flags))
+		return;
+
+	cpufreq_driver_adjust_perf(sg_cpu->cpu, sg_cpu->bw_dl,
+				   sg_cpu->util, max_cap);
+
+	sg_cpu->sg_policy->last_freq_update_time = time;
+}
+
+static unsigned int smut_next_freq_shared(struct smut_cpu *sg_cpu, u64 time)
+{
+	struct smut_policy *sg_policy = sg_cpu->sg_policy;
+	struct cpufreq_policy *policy = sg_policy->policy;
+	unsigned long util = 0, max_cap;
+	unsigned int j;
+
+	max_cap = arch_scale_cpu_capacity(sg_cpu->cpu);
+
+	for_each_cpu(j, policy->cpus) {
+		struct smut_cpu *j_sg_cpu = &per_cpu(smut_cpu, j);
+
+		smut_get_util(j_sg_cpu);
+		smut_iowait_apply(j_sg_cpu, time, max_cap);
+
+		util = max(j_sg_cpu->util, util);
+	}
+
+	return smut_next_freq(sg_policy, util, max_cap);
+}
+
+static void
+smut_update_shared(struct update_util_data *hook, u64 time, unsigned int flags)
+{
+	struct smut_cpu *sg_cpu = container_of(hook, struct smut_cpu, update_util);
+	struct smut_policy *sg_policy = sg_cpu->sg_policy;
+	unsigned int next_f;
+
+	raw_spin_lock(&sg_policy->update_lock);
+
+	smut_iowait_boost(sg_cpu, time, flags);
+	sg_cpu->last_update = time;
+
+	smut_ignore_dl_rate_limit(sg_cpu);
+
+	if (smut_should_update_freq(sg_policy, time)) {
+		next_f = smut_next_freq_shared(sg_cpu, time);
+
+		if (!smut_update_next_freq(sg_policy, time, next_f))
+			goto unlock;
+
+		if (sg_policy->policy->fast_switch_enabled)
+			cpufreq_driver_fast_switch(sg_policy->policy, next_f);
+		else
+			smut_deferred_update(sg_policy);
+	}
+unlock:
+	raw_spin_unlock(&sg_policy->update_lock);
+}
+
+static void smut_work(struct kthread_work *work)
+{
+	struct smut_policy *sg_policy = container_of(work, struct smut_policy, work);
+	unsigned int freq;
+	unsigned long flags;
+
+	/*
+	 * Hold sg_policy->update_lock shortly to handle the case where:
+	 * in case sg_policy->next_freq is read here, and then updated by
+	 * smut_deferred_update() just before work_in_progress is set to false
+	 * here, we may miss queueing the new update.
+	 *
+	 * Note: If a work was queued after the update_lock is released,
+	 * smut_work() will just be called again by kthread_work code; and the
+	 * request will be proceed before the smut thread sleeps.
+	 */
+	raw_spin_lock_irqsave(&sg_policy->update_lock, flags);
+	freq = sg_policy->next_freq;
+	sg_policy->work_in_progress = false;
+	raw_spin_unlock_irqrestore(&sg_policy->update_lock, flags);
+
+	mutex_lock(&sg_policy->work_lock);
+	__cpufreq_driver_target(sg_policy->policy, freq, CPUFREQ_RELATION_L);
+	mutex_unlock(&sg_policy->work_lock);
+}
+
+static void smut_irq_work(struct irq_work *irq_work)
+{
+	struct smut_policy *sg_policy;
+
+	sg_policy = container_of(irq_work, struct smut_policy, irq_work);
+
+	kthread_queue_work(&sg_policy->worker, &sg_policy->work);
+}
+
+/************************** sysfs interface ************************/
+
+static struct smut_tunables *smut_global_tunables;
+static DEFINE_MUTEX(smut_global_tunables_lock);
+
+static inline struct smut_tunables *to_smut_tunables(struct gov_attr_set *attr_set)
+{
+	return container_of(attr_set, struct smut_tunables, attr_set);
+}
+
+/*
+ * Plain tunables: only the value in struct smut_tunables changes, nothing
+ * needs to be pushed into the per-policy state.
+ */
+#define SMUT_TUNABLE_RW(name)						\
+static ssize_t name##_show(struct gov_attr_set *attr_set, char *buf)	\
+{									\
+	struct smut_tunables *tunables = to_smut_tunables(attr_set);	\
+	return sprintf(buf, "%u\n", tunables->name);			\
+}									\
+									\
+static ssize_t								\
+name##_store(struct gov_attr_set *attr_set, const char *buf, size_t count)\
+{									\
+	struct smut_tunables *tunables = to_smut_tunables(attr_set);	\
+	unsigned int val;						\
+									\
+	if (kstrtouint(buf, 10, &val))					\
+		return -EINVAL;						\
+									\
+	tunables->name = val;						\
+	return count;							\
+}									\
+									\
+static struct governor_attr name = __ATTR_RW(name)
+
+/*
+ * Rate limits also live in struct smut_policy (as nanoseconds), so they
+ * have to be pushed into every policy bound to this tunables set. After a
+ * change, min_rate_limit_ns has to be recomputed since either limit can
+ * now be the smaller of the two.
+ */
+#define SMUT_RATE_LIMIT_RW(name, field)					\
+static ssize_t name##_show(struct gov_attr_set *attr_set, char *buf)	\
+{									\
+	struct smut_tunables *tunables = to_smut_tunables(attr_set);	\
+	return sprintf(buf, "%u\n", tunables->name);			\
+}									\
+									\
+static ssize_t								\
+name##_store(struct gov_attr_set *attr_set, const char *buf, size_t count)\
+{									\
+	struct smut_tunables *tunables = to_smut_tunables(attr_set);	\
+	struct smut_policy *sg_policy;					\
+	unsigned int val;						\
+									\
+	if (kstrtouint(buf, 10, &val))					\
+		return -EINVAL;						\
+									\
+	tunables->name = val;						\
+									\
+	list_for_each_entry(sg_policy, &attr_set->policy_list, tunables_hook) { \
+		sg_policy->field = val * NSEC_PER_USEC;			\
+		smut_update_min_rate_limit_ns(sg_policy);		\
+	}								\
+									\
+	return count;							\
+}									\
+									\
+static struct governor_attr name = __ATTR_RW(name)
+
+SMUT_RATE_LIMIT_RW(up_rate_limit_us, up_rate_delay_ns);
+SMUT_RATE_LIMIT_RW(down_rate_limit_us, down_rate_delay_ns);
+
+SMUT_TUNABLE_RW(target_load1);
+SMUT_TUNABLE_RW(target_load2);
+SMUT_TUNABLE_RW(boost_light_pct);
+SMUT_TUNABLE_RW(cut_heavy_pct);
+SMUT_TUNABLE_RW(cap_light_pct);
+SMUT_TUNABLE_RW(cap_mid_pct);
+SMUT_TUNABLE_RW(cap_heavy_pct);
+
+static struct attribute *smut_attrs[] = {
+	&up_rate_limit_us.attr,
+	&down_rate_limit_us.attr,
+	&target_load1.attr,
+	&target_load2.attr,
+	&boost_light_pct.attr,
+	&cut_heavy_pct.attr,
+	&cap_light_pct.attr,
+	&cap_mid_pct.attr,
+	&cap_heavy_pct.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(smut);
+
+static void smut_tunables_free(struct kobject *kobj)
+{
+	struct gov_attr_set *attr_set = to_gov_attr_set(kobj);
+
+	kfree(to_smut_tunables(attr_set));
+}
+
+static const struct kobj_type smut_tunables_ktype = {
+	.default_groups = smut_groups,
+	.sysfs_ops = &governor_sysfs_ops,
+	.release = &smut_tunables_free,
+};
+
+/********************** cpufreq governor interface *********************/
+
+struct cpufreq_governor smartutil_gov;
+
+static struct smut_policy *smut_policy_alloc(struct cpufreq_policy *policy)
+{
+	struct smut_policy *sg_policy;
+
+	sg_policy = kzalloc(sizeof(*sg_policy), GFP_KERNEL);
+	if (!sg_policy)
+		return NULL;
+
+	sg_policy->policy = policy;
+	raw_spin_lock_init(&sg_policy->update_lock);
+	return sg_policy;
+}
+
+static void smut_policy_free(struct smut_policy *sg_policy)
+{
+	kfree(sg_policy);
+}
+
+static int smut_kthread_create(struct smut_policy *sg_policy)
+{
+	struct task_struct *thread;
+	struct sched_attr attr = {
+		.size		= sizeof(struct sched_attr),
+		.sched_policy	= SCHED_DEADLINE,
+		.sched_flags	= SCHED_FLAG_SUGOV,
+		.sched_nice	= 0,
+		.sched_priority	= 0,
+		/*
+		 * Fake (unused) bandwidth; workaround to "fix"
+		 * priority inheritance.
+		 */
+		.sched_runtime	=  1000000,
+		.sched_deadline = 10000000,
+		.sched_period	= 10000000,
+	};
+	struct cpufreq_policy *policy = sg_policy->policy;
+	int ret;
+
+	/* kthread only required for slow path */
+	if (policy->fast_switch_enabled)
+		return 0;
+
+	kthread_init_work(&sg_policy->work, smut_work);
+	kthread_init_worker(&sg_policy->worker);
+	thread = kthread_create(kthread_worker_fn, &sg_policy->worker,
+				"smut:%d",
+				cpumask_first(policy->related_cpus));
+	if (IS_ERR(thread)) {
+		pr_err("failed to create smut thread: %ld\n", PTR_ERR(thread));
+		return PTR_ERR(thread);
+	}
+
+	ret = sched_setattr_nocheck(thread, &attr);
+	if (ret) {
+		kthread_stop(thread);
+		pr_warn("%s: failed to set SCHED_DEADLINE\n", __func__);
+		return ret;
+	}
+
+	sg_policy->thread = thread;
+	kthread_bind_mask(thread, policy->related_cpus);
+	init_irq_work(&sg_policy->irq_work, smut_irq_work);
+	mutex_init(&sg_policy->work_lock);
+
+	wake_up_process(thread);
+
+	return 0;
+}
+
+static void smut_kthread_stop(struct smut_policy *sg_policy)
+{
+	/* kthread only required for slow path */
+	if (sg_policy->policy->fast_switch_enabled)
+		return;
+
+	kthread_flush_worker(&sg_policy->worker);
+	kthread_stop(sg_policy->thread);
+	mutex_destroy(&sg_policy->work_lock);
+}
+
+static struct smut_tunables *smut_tunables_alloc(struct smut_policy *sg_policy)
+{
+	struct smut_tunables *tunables;
+
+	tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
+	if (tunables) {
+		gov_attr_set_init(&tunables->attr_set, &sg_policy->tunables_hook);
+		if (!have_governor_per_policy())
+			smut_global_tunables = tunables;
+	}
+	return tunables;
+}
+
+static void smut_clear_global_tunables(void)
+{
+	if (!have_governor_per_policy())
+		smut_global_tunables = NULL;
+}
+
+static int smut_init(struct cpufreq_policy *policy)
+{
+	struct smut_policy *sg_policy;
+	struct smut_tunables *tunables;
+	static bool banner_printed;
+	int ret = 0;
+
+	/* State should be equivalent to EXIT */
+	if (policy->governor_data)
+		return -EBUSY;
+
+	if (!banner_printed) {
+		banner_printed = true;
+		pr_info("%s by %s\n",
+			CPUFREQ_SMARTUTIL_PROGNAME, CPUFREQ_SMARTUTIL_AUTHOR);
+	}
+
+	cpufreq_enable_fast_switch(policy);
+
+	sg_policy = smut_policy_alloc(policy);
+	if (!sg_policy) {
+		ret = -ENOMEM;
+		goto disable_fast_switch;
+	}
+
+	ret = smut_kthread_create(sg_policy);
+	if (ret)
+		goto free_sg_policy;
+
+	mutex_lock(&smut_global_tunables_lock);
+
+	if (smut_global_tunables) {
+		if (WARN_ON(have_governor_per_policy())) {
+			ret = -EINVAL;
+			goto stop_kthread;
+		}
+		policy->governor_data = sg_policy;
+		sg_policy->tunables = smut_global_tunables;
+
+		gov_attr_set_get(&smut_global_tunables->attr_set, &sg_policy->tunables_hook);
+		goto out;
+	}
+
+	tunables = smut_tunables_alloc(sg_policy);
+	if (!tunables) {
+		ret = -ENOMEM;
+		goto stop_kthread;
+	}
+
+	/*
+	 * Defaults. Kept conservative on purpose: nothing here should change
+	 * behaviour dramatically before the owner has had a chance to
+	 * calibrate on real hardware.
+	 *
+	 *  - up_rate_limit_us   1ms   : react quickly when load appears
+	 *  - down_rate_limit_us 2ms   : let an idle CPU fall to policy->min
+	 *  - target_load1/2      40/80 : light / medium / heavy boundaries
+	 *  - boost_light_pct     10    : small headroom at light load
+	 *  - cut_heavy_pct       10    : trim at heavy load, main heat control
+	 *  - cap_*_pct           100   : per-tier ceilings disabled by default
+	 *
+	 * Note the ANDROID up/down patch this is modelled on used
+	 * cpufreq_policy_transition_delay_us(policy) for both limits. Explicit
+	 * values are used here so that the two directions are independently
+	 * tunable from the start rather than tied to the driver's single
+	 * transition delay.
+	 */
+	tunables->up_rate_limit_us	= 1000;
+	tunables->down_rate_limit_us	= 2000;
+	tunables->target_load1		= 40;
+	tunables->target_load2		= 80;
+	tunables->boost_light_pct	= 10;
+	tunables->cut_heavy_pct		= 10;
+	tunables->cap_light_pct		= 100;
+	tunables->cap_mid_pct		= 100;
+	tunables->cap_heavy_pct		= 100;
+
+	policy->governor_data = sg_policy;
+	sg_policy->tunables = tunables;
+
+	ret = kobject_init_and_add(&tunables->attr_set.kobj, &smut_tunables_ktype,
+				   get_governor_parent_kobj(policy), "%s",
+				   smartutil_gov.name);
+	if (ret)
+		goto fail;
+
+out:
+	mutex_unlock(&smut_global_tunables_lock);
+	return 0;
+
+fail:
+	kobject_put(&tunables->attr_set.kobj);
+	policy->governor_data = NULL;
+	smut_clear_global_tunables();
+
+stop_kthread:
+	smut_kthread_stop(sg_policy);
+	mutex_unlock(&smut_global_tunables_lock);
+
+free_sg_policy:
+	smut_policy_free(sg_policy);
+
+disable_fast_switch:
+	cpufreq_disable_fast_switch(policy);
+
+	pr_err("initialization failed (error %d)\n", ret);
+	return ret;
+}
+
+static void smut_exit(struct cpufreq_policy *policy)
+{
+	struct smut_policy *sg_policy = policy->governor_data;
+	struct smut_tunables *tunables = sg_policy->tunables;
+	unsigned int count;
+
+	mutex_lock(&smut_global_tunables_lock);
+
+	count = gov_attr_set_put(&tunables->attr_set, &sg_policy->tunables_hook);
+	policy->governor_data = NULL;
+	if (!count)
+		smut_clear_global_tunables();
+
+	mutex_unlock(&smut_global_tunables_lock);
+
+	smut_kthread_stop(sg_policy);
+	smut_policy_free(sg_policy);
+	cpufreq_disable_fast_switch(policy);
+}
+
+static int smut_start(struct cpufreq_policy *policy)
+{
+	struct smut_policy *sg_policy = policy->governor_data;
+	void (*uu)(struct update_util_data *data, u64 time, unsigned int flags);
+	unsigned int cpu;
+
+	sg_policy->up_rate_delay_ns =
+		sg_policy->tunables->up_rate_limit_us * NSEC_PER_USEC;
+	sg_policy->down_rate_delay_ns =
+		sg_policy->tunables->down_rate_limit_us * NSEC_PER_USEC;
+	smut_update_min_rate_limit_ns(sg_policy);
+	sg_policy->last_freq_update_time	= 0;
+	sg_policy->next_freq			= 0;
+	sg_policy->work_in_progress		= false;
+	sg_policy->limits_changed		= false;
+	sg_policy->cached_raw_freq		= 0;
+
+	sg_policy->need_freq_update = cpufreq_driver_test_flags(CPUFREQ_NEED_UPDATE_LIMITS);
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct smut_cpu *sg_cpu = &per_cpu(smut_cpu, cpu);
+
+		memset(sg_cpu, 0, sizeof(*sg_cpu));
+		sg_cpu->cpu			= cpu;
+		sg_cpu->sg_policy		= sg_policy;
+	}
+
+	if (policy_is_shared(policy))
+		uu = smut_update_shared;
+	else if (policy->fast_switch_enabled && cpufreq_driver_has_adjust_perf())
+		uu = smut_update_single_perf;
+	else
+		uu = smut_update_single_freq;
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct smut_cpu *sg_cpu = &per_cpu(smut_cpu, cpu);
+
+		cpufreq_add_update_util_hook(cpu, &sg_cpu->update_util, uu);
+	}
+	return 0;
+}
+
+static void smut_stop(struct cpufreq_policy *policy)
+{
+	struct smut_policy *sg_policy = policy->governor_data;
+	unsigned int cpu;
+
+	for_each_cpu(cpu, policy->cpus)
+		cpufreq_remove_update_util_hook(cpu);
+
+	synchronize_rcu();
+
+	if (!policy->fast_switch_enabled) {
+		irq_work_sync(&sg_policy->irq_work);
+		kthread_cancel_work_sync(&sg_policy->work);
+	}
+}
+
+static void smut_limits(struct cpufreq_policy *policy)
+{
+	struct smut_policy *sg_policy = policy->governor_data;
+
+	if (!policy->fast_switch_enabled) {
+		mutex_lock(&sg_policy->work_lock);
+		cpufreq_policy_apply_limits(policy);
+		mutex_unlock(&sg_policy->work_lock);
+	}
+
+	sg_policy->limits_changed = true;
+}
+
+struct cpufreq_governor smartutil_gov = {
+	.name			= "smartutil",
+	.owner			= THIS_MODULE,
+	.flags			= CPUFREQ_GOV_DYNAMIC_SWITCHING,
+	.init			= smut_init,
+	.exit			= smut_exit,
+	.start			= smut_start,
+	.stop			= smut_stop,
+	.limits			= smut_limits,
+};
+
+#ifdef CONFIG_CPU_FREQ_DEFAULT_GOV_SMARTUTIL
+struct cpufreq_governor *cpufreq_default_governor(void)
+{
+	return &smartutil_gov;
+}
+#endif
+
+cpufreq_governor_init(smartutil_gov);
+
+MODULE_AUTHOR(CPUFREQ_SMARTUTIL_AUTHOR);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION(CPUFREQ_SMARTUTIL_PROGNAME);
