@@ -182,6 +188,28 @@ static bool check_block(struct file *fp, loff_t *pos, loff_t block_end, u8 *matc
     return signature_valid;
 }
 
+/**
+ * ksu_manager_uapi_version - UAPI version a manager build was compiled against.
+ * @signature_index: index into apk_sign_keys[], or one of the reserved
+ *                   KSU_SIGNATURE_INDEX_* values.
+ *
+ * Managers compare the uapi_version reported by KSU_IOCTL_GET_INFO against the
+ * KERNEL_SU_UAPI_VERSION they were built with, and hide the root-only screens
+ * when they differ. Reporting a single global version therefore breaks every
+ * manager that lags behind the kernel.
+ *
+ * 0 means "follow the kernel": report KERNEL_SU_UAPI_VERSION. That is the right
+ * answer for any fork that tracks upstream, and also for the reserved indices
+ * (dynamic manager, ksu debug manager, toolkit manager).
+ */
+unsigned ksu_manager_uapi_version(u8 signature_index)
+{
+    if (signature_index >= ARRAY_SIZE(apk_sign_keys))
+        return 0;
+
+    return apk_sign_keys[signature_index].uapi_version;
+}
