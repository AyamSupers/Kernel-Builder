@@ -13,6 +14,7 @@ u16 ksu_last_manager_appid = KSU_INVALID_APPID;
 struct ksu_manager_node {
     u8 signature_index;
     u16 appid;
+    unsigned uapi_version;
     struct list_head list;
     struct rcu_head rcu;
 };
@@ -65,6 +67,7 @@ void ksu_register_manager(u32 uid, u8 signature_index)
 
     node->appid = appid;
     node->signature_index = signature_index;
+    node->uapi_version = ksu_manager_uapi_version(signature_index);
 
     spin_lock(&ksu_manager_list_write_lock);
 
@@ -221,3 +224,37 @@ int ksu_get_manager_signature_index_by_appid(u16 appid)
     rcu_read_unlock();
     return -ENODATA;
 }
+
+/**
+ * ksu_current_manager_uapi_version - UAPI version to report to the calling manager.
+ *
+ * Resolves the UAPI version of the manager that is currently talking to us, so
+ * a manager built against an older UAPI (e.g. MamboSU on UAPI 5) keeps its
+ * root-only screens on a kernel that already moved to a newer UAPI. The newer
+ * UAPI is additive, so downgrading the reported number is safe.
+ *
+ * Forks that track upstream report the kernel's own KERNEL_SU_UAPI_VERSION.
+ */
+unsigned ksu_current_manager_uapi_version(void)
+{
+    struct ksu_manager_node *pos;
+    u16 appid;
+    unsigned uapi_version = KERNEL_SU_UAPI_VERSION;
+
+    if (!is_manager())
+        return KERNEL_SU_UAPI_VERSION;
+
+    appid = ksu_get_uid_t(current_uid()) % PER_USER_RANGE;
+
+    rcu_read_lock();
+    list_for_each_entry_rcu (pos, &ksu_manager_appid_list, list) {
+        if (pos->appid == appid) {
+            if (pos->uapi_version)
+                uapi_version = pos->uapi_version;
+            break;
+        }
+    }
+    rcu_read_unlock();
+
+    return uapi_version;
+}
